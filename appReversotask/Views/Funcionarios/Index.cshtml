@model IEnumerable<appReversotask.Models.Funcionario>

@{
    ViewData["Title"] = "Funcionários";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Funcionários</h1>
        <p class="text-muted mb-0">Gerencie os colaboradores do sistema</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Novo Funcionário
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5">
        <i class="bi bi-people display-6 d-block mb-3"></i>
        <h5>Nenhum funcionário cadastrado</h5>
        <p class="mb-3">Comece cadastrando o primeiro colaborador.</p>
        <a asp-action="Create" class="btn btn-primary">Cadastrar Funcionário</a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">@Html.DisplayNameFor(model => model.Nome)</th>
                            <th>@Html.DisplayNameFor(model => model.Cargo)</th>
                            <th>@Html.DisplayNameFor(model => model.Gerente)</th>
                            <th class="text-end pe-3" style="width: 180px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-medium">@Html.DisplayFor(modelItem => item.Nome)</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                        @Html.DisplayFor(modelItem => item.Cargo)
                                    </span>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Gerente.Cargo)
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Codigo"
                                           class="btn btn-outline-secondary" title="Detalhes">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Codigo"
                                           class="btn btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Codigo"
                                           class="btn btn-outline-danger" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}