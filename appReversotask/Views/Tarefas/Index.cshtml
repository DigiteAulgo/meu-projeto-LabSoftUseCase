@model IEnumerable<appReversotask.Models.Tarefa>

@{
    ViewData["Title"] = "Tarefas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Tarefas</h1>
        <p class="text-muted mb-0">Acompanhe e gerencie todas as tarefas do sistema</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Nova Tarefa
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5">
        <i class="bi bi-list-task display-6 d-block mb-3"></i>
        <h5>Nenhuma tarefa cadastrada</h5>
        <p class="mb-3">Comece criando a primeira tarefa.</p>
        <a asp-action="Create" class="btn btn-primary">Criar Tarefa</a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">@Html.DisplayNameFor(model => model.Descricao)</th>
                            <th>@Html.DisplayNameFor(model => model.StatusTarefa)</th>
                            <th>@Html.DisplayNameFor(model => model.Prazo)</th>
                            <th>@Html.DisplayNameFor(model => model.DataPlanejada)</th>
                            <th>@Html.DisplayNameFor(model => model.Funcionario)</th>
                            <th class="text-end pe-3" style="width: 180px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-medium">@Html.DisplayFor(modelItem => item.Descricao)</div>
                                </td>
                                <td>
                                    @{
                                        var status = item.StatusTarefa?.ToString() ?? "";
                                        var statusClass = status switch
                                        {
                                            "Concluída" or "Finalizada" => "bg-success",
                                            "Em Andamento" or "Iniciada" => "bg-primary",
                                            "Cancelada" => "bg-danger",
                                            "Pendente" or "Planejada" => "bg-warning text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusClass">
                                        @Html.DisplayFor(modelItem => item.StatusTarefa)
                                    </span>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Prazo)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DataPlanejada)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Funcionario.Cargo)
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Codigo"
                                           class="btn btn-outline-secondary" title="Detalhes">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Codigo"
                                           class="btn btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Codigo"
                                           class="btn btn-outline-danger" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}