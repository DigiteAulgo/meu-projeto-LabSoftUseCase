@model IEnumerable<appReversotask.Models.Tarefa>
@{
    ViewData["Title"] = "Tarefas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-list-task text-primary"></i> Tarefas
        </h2>
        <p class="text-muted mb-0">Acompanhe o ciclo de vida das tarefas</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nova Tarefa
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Descrição</th>
                        <th>Planejada</th>
                        <th>Iniciada</th>
                        <th>Finalizada</th>
                        <th>Status</th>
                        <th>Prazo</th>
                        <th>Funcionário</th>
                        <th class="text-end" style="width: 160px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Descricao)</td>
                            <td>@Html.DisplayFor(modelItem => item.DataPlanejada)</td>
                            <td>@Html.DisplayFor(modelItem => item.DataIniciada)</td>
                            <td>@Html.DisplayFor(modelItem => item.DataFinalizada)</td>
                            <td>
                                @{
                                    var status = item.StatusTarefa?.ToString() ?? "";
                                    var badgeClass = status switch
                                    {
                                        "Concluida" or "Finalizada" or "Concluída" => "bg-success",
                                        "EmAndamento" or "Iniciada" or "Em Andamento" => "bg-primary",
                                        "Cancelada" => "bg-danger",
                                        "Pendente" or "Planejada" => "bg-secondary",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@status</span>
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Prazo)</td>
                            <td>@Html.DisplayFor(modelItem => item.Funcionario.Cargo)</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-outline-primary" title="Detalhes">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-outline-secondary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center mt-4">
        <i class="bi bi-info-circle me-2"></i> Nenhuma tarefa cadastrada.
    </div>
}