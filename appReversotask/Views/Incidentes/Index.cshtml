@model IEnumerable<appReversotask.Models.Incidente>
@{
    ViewData["Title"] = "Incidentes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-exclamation-triangle text-warning"></i> Incidentes
        </h2>
        <p class="text-muted mb-0">Registro e acompanhamento de problemas</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Novo Incidente
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.DescricaoProblema)</th>
                        <th>@Html.DisplayNameFor(model => model.DataIncidente)</th>
                        <th>@Html.DisplayNameFor(model => model.Solucao)</th>
                        <th>@Html.DisplayNameFor(model => model.Resolvido)</th>
                        <th class="text-end" style="width: 160px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(modelItem => item.DescricaoProblema)</td>
                            <td>@Html.DisplayFor(modelItem => item.DataIncidente)</td>
                            <td>@Html.DisplayFor(modelItem => item.Solucao)</td>
                            <td>
                                @if (item.Resolvido?.Trim().ToUpper() == "SIM")
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i> Resolvido
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle me-1"></i> Pendente
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-outline-primary" title="Detalhes">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-outline-secondary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center mt-4">
        <i class="bi bi-info-circle me-2"></i> Nenhum incidente registrado.
    </div>
}