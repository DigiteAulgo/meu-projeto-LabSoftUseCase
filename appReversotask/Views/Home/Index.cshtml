@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold text-primary">
        <i class="bi bi-kanban"></i> Bem-vindo ao ReversoTask
    </h1>
    <p class="lead text-muted">
        Sistema de gestão de tarefas, funcionários e incidentes
    </p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center">
                <i class="bi bi-list-task display-4 text-primary mb-3"></i>
                <h5 class="card-title">Tarefas</h5>
                <p class="card-text text-muted">Gerencie o ciclo de vida das tarefas da equipe.</p>
                <a asp-controller="Tarefas" asp-action="Index" class="btn btn-primary">
                    Acessar <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center">
                <i class="bi bi-people display-4 text-success mb-3"></i>
                <h5 class="card-title">Funcionários</h5>
                <p class="card-text text-muted">Cadastro e visualização da equipe.</p>
                <a asp-controller="Funcionarios" asp-action="Index" class="btn btn-success">
                    Acessar <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center">
                <i class="bi bi-exclamation-triangle display-4 text-warning mb-3"></i>
                <h5 class="card-title">Incidentes</h5>
                <p class="card-text text-muted">Registro e acompanhamento de problemas.</p>
                <a asp-controller="Incidentes" asp-action="Index" class="btn btn-warning">
                    Acessar <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>